{
  "name": "media-renamer",
  "version": "0.3.0",
  "private": true,
  "description": "A confidence-first TV episode and movie renamer",
  "author": "Rob <373278+manix84@users.noreply.github.com>",
  "homepage": "https://github.com/manix84/media-renamer",
  "desktopName": "io.github.manix84.media-renamer.desktop",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"npm:electron:watch\"",
    "dev:electron": "npm run dev",
    "electron:watch": "node scripts/dev-electron.mjs",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "tsc -b && vite build && npm run build:electron",
    "package": "npm run build && electron-builder",
    "package:linux": "npm run build && electron-builder --linux AppImage deb rpm --x64 --publish never",
    "package:linux:portable": "npm run build && electron-builder --linux AppImage --x64 --publish never && node scripts/package-linux-portable.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "build:tmdb-helper": "node scripts/build-tmdb-helper.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "beforePack": "scripts/verify-tmdb-helper.mjs",
    "appId": "io.github.manix84.media-renamer",
    "productName": "Media Renamer",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/app-icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "native-helper-dist",
        "to": "bin",
        "filter": [
          "tmdb-helper*"
        ]
      },
      {
        "from": "extensions-preinstalled",
        "to": "extensions",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/app-icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/app-icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "category": "Utility",
      "icon": "assets/app-icon.png",
      "executableName": "media-renamer",
      "maintainer": "Rob <373278+manix84@users.noreply.github.com>",
      "synopsis": "Confidence-first TV episode and movie renaming",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  }
}
